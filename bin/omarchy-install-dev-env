#!/bin/bash

# omarchy:summary=Install a supported development environment
# omarchy:name=dev-env
# omarchy:args=<node|bun|deno|python>
# omarchy:examples=omarchy install dev-env node | omarchy install dev-env python
# omarchy:requires-sudo=true

if [[ -z $1 ]]; then
  echo "Usage: omarchy-install-dev-env <node|bun|deno|python>" >&2
  exit 1
fi

install_node() {
  echo -e "Installing Node.js...\n"
  mise use --global node
}

case "$1" in
node)
  install_node
  ;;
bun)
  echo -e "Installing Bun...\n"
  mise use -g bun@latest
  ;;
deno)
  echo -e "Installing Deno...\n"
  mise use -g deno@latest
  ;;
python)
  echo -e "Installing Python...\n"
  mise use --global python@latest
  echo -e "\nInstalling uv...\n"
  curl -fsSL https://astral.sh/uv/install.sh | sh
  ;;
*)
  echo "Unknown environment: $1"
  exit 1
  ;;
esac
