  case $(menu "Update channel" "🟢 Stable\n🟡 RC\n🟠 Edge\n🔴 Dev") in
  *Stable*) present_terminal "omarchy-channel-set stable" ;;
  *RC*) present_terminal "omarchy-channel-set rc" ;;
